### Copy to /var/lib/marzban-node/.env on the server (docker-compose loads it).
### Smart DNS: without HYSTERIA2_TRAFFIC_SECRET (same as hysteria trafficStats.secret) the panel shows 0 conn / 0 Mbps.

SERVICE_HOST = "0.0.0.0"
SERVICE_PORT = 62050

XRAY_API_HOST = "0.0.0.0"
XRAY_API_PORT = 62051
# XRAY_EXECUTABLE_PATH = /usr/local/bin/xray
# XRAY_ASSETS_PATH = /usr/local/share/xray

SSL_CERT_FILE = /var/lib/marzban-node/ssl_cert.pem
SSL_KEY_FILE = /var/lib/marzban-node/ssl_key.pem
SSL_CLIENT_CERT_FILE = /var/lib/marzban-node/ssl_client_cert.pem

### can be rest or rpyc
# SERVICE_PROTOCOL = rpyc

### for developers
# DEBUG = false

### Select Specific Inbounds
# INBOUNDS = "VLESS TCP REALITY, VMESS TCP NO TLS"

### MTProto sidecar on this node only
# MTPROTO_ENABLED = false
# MTPROTO_DOMAIN = tg.example.com
# MTPROTO_PORT = 1443
# MTPROTO_MODE = dd                      # or ee (Fake TLS); ee requires MTPROTO_TLS_DOMAIN
# MTPROTO_TLS_DOMAIN = cdn.example.com   # SNI host telemt mimics; required if MTPROTO_MODE=ee; must match panel MTPROTO_TLS_DOMAIN
# MTPROTO_USE_MIDDLE_PROXY = true
# MTPROTO_LISTEN_ADDR_IPV4 = 0.0.0.0
# MTPROTO_IPV6_ENABLED = false
# MTPROTO_NETWORK_PREFER = 4
# MTPROTO_SHOW_LINKS = false
# MTPROTO_LOG_LEVEL = normal
# MTPROTO_RUST_LOG = info,telemt::links=warn
# MTPROTO_RELOAD_INTERVAL = 5
# MTPROTO_PROCESS_RESTART_DELAY_MS = 1000
# MTPROTO_UPSTREAM_CONNECT_RETRY_ATTEMPTS = 3
# MTPROTO_UPSTREAM_CONNECT_RETRY_BACKOFF_MS = 250
# MTPROTO_UPSTREAM_CONNECT_BUDGET_MS = 25000
# MTPROTO_UPSTREAM_UNHEALTHY_FAIL_THRESHOLD = 3
# MTPROTO_UPSTREAM_CONNECT_FAILFAST_HARD_ERRORS = false
# MTPROTO_CLIENT_HANDSHAKE_TIMEOUT = 25
# MTPROTO_TG_CONNECT_TIMEOUT = 20
# MTPROTO_CLIENT_KEEPALIVE_TIMEOUT = 60
# MTPROTO_CLIENT_ACK_TIMEOUT = 300
# MTPROTO_CONFIG_PATH = /var/lib/marzban-node/mtproto/telemt.toml

### Hysteria2 sidecar (hysteriad)
### Run setup-hysteria-node.sh to populate these values automatically.
# HYSTERIA2_ENABLED = false
# HYSTERIA2_PORT = 2087
# HYSTERIA2_MARZBAN_URL = https://panel.example.com
# HYSTERIA2_HOOK_TOKEN = <same as HYSTERIA2_HOOK_TOKEN in main Marzban .env>
# HYSTERIA2_TRAFFIC_SECRET = <generated by setup-hysteria-node.sh>
# HYSTERIA2_TRAFFIC_LISTEN = 0.0.0.0:9999
# HYSTERIA2_UP_MBPS = 500
# HYSTERIA2_DOWN_MBPS = 500
# HYSTERIA2_CERT_FILE = /var/lib/marzban-node/ssl_cert.pem
# HYSTERIA2_KEY_FILE  = /var/lib/marzban-node/ssl_key.pem

## Smart DNS: GET /metrics sampling interval (seconds)
# NODE_METRICS_INTERVAL = 3
